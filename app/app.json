{
  "expo": {
    "name": "FitBeacon",
    "slug": "fitbeacon",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/icon-1024.png",
    "userInterfaceStyle": "automatic",
    "androidStatusBar": {
      "barStyle": "light-content",
      "backgroundColor": "#070A0E"
    },
    "splash": {
      "image": "./assets/brand/splash-logo-1024.png",
      "resizeMode": "contain",
      "backgroundColor": "#070A0E"
    },
    "scheme": "fitbeacon",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.fitbeacon.app",
      "blockedPermissions": [
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#070A0E",
        "foregroundImage": "./assets/brand/adaptive-icon-foreground-1024.png",
        "monochromeImage": "./assets/brand/adaptive-icon-monochrome-1024.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/brand/favicon-48.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "react-native-ble-plx",
        {
          "neverForLocation": true
        }
      ],
      "expo-video",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permita o acesso às fotos para escolher sua imagem de perfil.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-navigation-bar",
        {
          "style": "dark"
        }
      ]
    ]
  }
}
